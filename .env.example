# ── 服务 ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# 由 CI / compose 注入，用于 /healthz 与排查
APP_VERSION=dev

# ── 数据库 ──────────────────────────────────────────────────────
# 生产：postgres://suishouji:强密码@postgres:5432/suishouji
DATABASE_URL=postgres://suishouji:suishouji@localhost:5432/suishouji
DB_POOL_MAX=10

# ── 认证 ────────────────────────────────────────────────────────
# 生成：openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# 生成：openssl rand -base64 24
REFRESH_TOKEN_PEPPER=

# ── 注册策略 ────────────────────────────────────────────────────
# false 时只有持邀请码的人能注册
ALLOW_REGISTER=false
INVITE_CODE=

# ── CORS（逗号分隔） ────────────────────────────────────────────
# 手机壳改 origin 后填 https://app.suishouji.local，iOS 填 capacitor://localhost
CORS_ORIGINS=

# ── 对象存储（阶段 2 图片上云用） ────────────────────────────────
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── 高德（只放服务端，供 /geo 代理，绝不下发到客户端） ──────────────
AMAP_KEY=
