{
  "name": "suishouji-server",
  "version": "0.1.0",
  "private": true,
  "description": "随手记 后端服务（账号 / 云备份 / 增量同步 / 管理端 API）",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.2.6",
    "@node-rs/argon2": "^2.2.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.6",
    "@swc/core": "^1.16.2",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pg-mem": "^3.0.14",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "unplugin-swc": "^1.6.0",
    "vitest": "^3.2.7"
  }
}
