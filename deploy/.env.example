# ── 部署编排（docker compose 的变量替换用；同一份文件也会作为 api 容器的 env_file）──

# 对外域名：Caddy 用它申请证书，DNS 请先解析到本机公网 IP（境内需已备案）
API_DOMAIN=api.landery.cn
# 镜像地址（CI 构建后推送到 registry）
API_IMAGE=ghcr.io/yourname/suishouji-server:latest
APP_VERSION=

# ── 数据库 ──
POSTGRES_USER=suishouji
POSTGRES_PASSWORD=请换成强密码
POSTGRES_DB=suishouji
BACKUP_KEEP_DAYS=30

# ── 备份异地加密（可选，强烈建议）──
RESTIC_REPOSITORY=
RESTIC_PASSWORD=

# ── 应用（api 容器读取）──
NODE_ENV=production
LOG_LEVEL=info
# openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# openssl rand -base64 24
REFRESH_TOKEN_PEPPER=

ALLOW_REGISTER=false
INVITE_CODE=
# 手机壳 origin 改完后填 https://app.suishouji.local ；iOS 是 capacitor://localhost
CORS_ORIGINS=https://app.suishouji.local,capacitor://localhost

# ── 对象存储（图片上云后填）──
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── 高德（只放服务端，绝不下发到客户端）──
AMAP_KEY=
